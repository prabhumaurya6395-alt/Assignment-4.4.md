1. Metadata code
Add this code inside the <head> section of every HTML file.


<head>

    <!-- Character Encoding -->
    <meta charset="UTF-8">

    <!-- Mobile Responsive Viewport -->
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <!-- Page Title -->
    <title>My HTML Project</title>

    <!-- Page Description -->
    <meta name="description"
          content="A student HTML project demonstrating forms, tables and HTML concepts.">

    <!-- Favicon -->
    <link rel="icon" type="image/png" href="favicon.png">

    <!-- CSS File -->
    <link rel="stylesheet" href="style.css">

</head>
